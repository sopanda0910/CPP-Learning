{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: build active file",
      "type": "cppbuild",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-std=c++20", "-g", "-Wall", "-Wextra", "-pedantic",
        "${file}",
        "-o", "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}",
        "env": { "PATH": "C:/msys64/ucrt64/bin;${env:PATH}" }
      },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
